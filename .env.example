# Plantilla de desarrollo: API en Fedora + servicios de compose.yaml.
# No contiene credenciales privadas. notifications_dev es la clave pública local de Compose.
# Para una instalación nueva, copiar a .env solo si ese archivo todavía no existe.
# Si ya tienes un .env privado, conservarlo y agregar únicamente las variables que falten.
# Spring no carga .env por sí mismo. En Bash: set -a; source .env; set +a
# Las contraseñas/valores con espacios o símbolos deben escribirse entre comillas simples.

# Puerto HTTP de Notificaciones.
SERVER_PORT=8084

# PostgreSQL local. En producción, reemplazar por la conexión de RDS del servicio.
DB_URL='jdbc:postgresql://127.0.0.1:5434/notifications_db'
DB_USERNAME=notifications_user
DB_PASSWORD=notifications_dev
# Conserva la generación de esquema que usa actualmente el servicio.
DB_DDL_AUTO=update

# RabbitMQ local; la aplicación consume y declara las colas al arrancar.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_USER=notifications_dev
RABBITMQ_PASSWORD=notifications_dev
RABBITMQ_SSL=false
# Opcional: variable nativa Spring para un vhost ya creado y con permisos.
# Si se omite, se utiliza el vhost /.
# SPRING_RABBITMQ_VIRTUAL_HOST=notifications_e2e_test

# Mailpit captura los correos localmente; buzón http://localhost:8025.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=boletin@athenet.test
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# URLs que aparecerán en los correos y orígenes admitidos del frontend.
NOTIFICATIONS_PUBLIC_API_URL=http://localhost:8084
FRONT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
# PUBLIC_SITE_URL es un alias alternativo: se usa únicamente si FRONT_URL no está definido.
# PUBLIC_SITE_URL=http://localhost:5173

# Turnstile del backend. Vacío: el registro responde 503 hasta configurar la clave.
# La clave pública del widget la configura el compañero en el frontend.
TURNSTILE_SECRET_KEY=
# Con las claves oficiales de prueba, Siteverify responde hostname example.com.
# Para producción, usar los hostnames reales del frontend, separados por coma y sin https:// ni rutas.
TURNSTILE_ALLOWED_HOSTNAMES=example.com

# Referencia para adaptar ESTA plantilla a producción (editar las asignaciones anteriores):
# - RDS: endpoint, usuario y contraseña propios del servicio; no usar el contenedor local.
#   Las comillas protegen los & de los parámetros JDBC al cargar el archivo desde Bash.
# DB_URL='jdbc:postgresql://TU_ENDPOINT_RDS:5432/notifications_db?sslmode=require&connectTimeout=10&socketTimeout=30'
# DB_USERNAME=notifications_user
# DB_PASSWORD=''
# - RabbitMQ: host de EC2, puerto, usuario, contraseña y SSL según el broker real.
# RABBITMQ_HOST=TU_HOST_RABBITMQ
# RABBITMQ_PORT=5672
# RABBITMQ_USER=TU_USUARIO_RABBITMQ
# RABBITMQ_PASSWORD=''
# - Gmail: cuenta remitente y contraseña de aplicación de esa cuenta, sin espacios de presentación.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=''
# MAIL_FROM=tu-cuenta@gmail.com
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# - Configurar también URLs públicas, CORS, TURNSTILE_SECRET_KEY y TURNSTILE_ALLOWED_HOSTNAMES reales.
# - Esta plantilla no define COMPETITION_API_URL: el servicio ya no consulta Competencia por HTTP.

# Avisos de MATCH/TRACKDAY: activar solo tras migrar la BD y preparar el productor de Eventos.
# APP_NEWSLETTER_EVENTS_ENABLED=true
