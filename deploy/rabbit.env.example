# Plantilla para el .env del cluster de RabbitMQ en la EC2.
# NO se versiona el archivo real.

RABBIT_USER=athenet_admin
RABBIT_PASS=REEMPLAZAR_PASSWORD_FUERTE

# Secreto compartido que permite a los dos nodos reconocerse. Cualquier cadena
# larga y aleatoria sirve, pero tiene que ser IDENTICA en ambos nodos.
# Generala con:  openssl rand -hex 32
RABBIT_COOKIE=REEMPLAZAR_COOKIE_ALEATORIA
