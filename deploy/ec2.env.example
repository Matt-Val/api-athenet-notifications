# Copiar a deploy/.env y completar en privado. No usar la plantilla local Mailpit.
# Valores literales entre comillas simples; Compose no interpreta $ dentro de ellas.
DB_URL='jdbc:postgresql://REEMPLAZAR_RDS:5432/notifications_db?sslmode=require&connectTimeout=10&socketTimeout=30'
DB_USERNAME='REEMPLAZAR'
DB_PASSWORD='REEMPLAZAR'
DB_DDL_AUTO=validate
RABBITMQ_HOST='REEMPLAZAR_HOST_RABBITMQ'
RABBITMQ_PORT=5672
RABBITMQ_USER='REEMPLAZAR'
RABBITMQ_PASSWORD='REEMPLAZAR'
RABBITMQ_SSL=false
SPRING_RABBITMQ_VIRTUAL_HOST='/'
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME='REEMPLAZAR@gmail.com'
MAIL_PASSWORD='REEMPLAZAR_CONTRASENA_DE_APLICACION'
MAIL_FROM='REEMPLAZAR@gmail.com'
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
NOTIFICATIONS_PUBLIC_API_URL='https://REEMPLAZAR_API_PUBLICA'
FRONT_URL='https://REEMPLAZAR_FRONT'
CORS_ALLOWED_ORIGINS='https://REEMPLAZAR_FRONT'
TURNSTILE_SECRET_KEY='REEMPLAZAR_CLAVE_REAL'
TURNSTILE_ALLOWED_HOSTNAMES='REEMPLAZAR_HOSTNAME_FRONT'
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError'
